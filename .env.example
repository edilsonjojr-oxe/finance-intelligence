# Vazio: PostgreSQL embarcado (PGlite) com persistência em .data/finance.
# Em produção: PostgreSQL dedicado e HTTPS; consulte README.md.
DATABASE_URL=
# Use somente no comando npm run db:migrate, com privilégios de migração.
# Prefira injetar pelo terminal, sem manter esta credencial no processo da aplicação.
DATABASE_MIGRATION_URL=
FINANCE_DATA_DIR=.data/finance
APP_ORIGIN=http://127.0.0.1:3000
# Ative SOMENTE atrás de HTTPS:
COOKIE_SECURE=false
# Na nuvem, configure uma origem HTTPS e use npm run start:cloud.
# Token aleatório de pelo menos 32 caracteres para proteger o primeiro cadastro.
SETUP_TOKEN=
